# ─── Discord ────────────────────────────────────────────────────────────────
# Portal → tu app → Bot → Reset Token. Se ve UNA sola vez.
DISCORD_BOT_TOKEN=

# ─── Aplicación Limitless ───────────────────────────────────────────────────
# URL pública de la app (sin barra al final). El bot le avisa de testimonios y
# de vinculaciones pendientes.
LIMITLESS_API_URL=https://tu-app.vercel.app
# Tiene que ser EL MISMO valor que la variable LIMITLESS_WEBHOOK_SECRET de
# Vercel: es lo único que autentica al bot contra la app.
LIMITLESS_WEBHOOK_SECRET=

# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=
# Service role: el bot escribe saltando RLS. NO es la anon key.
SUPABASE_SERVICE_ROLE_KEY=

NODE_ENV=production
