# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI COO
# Landing VSL (YouTube/Loom embed URL) — vacío muestra placeholder
NEXT_PUBLIC_VSL_URL=
# Org UUID para atribución UTM en la landing pública (waitlist + clicks)
NEXT_PUBLIC_UTM_ORGANIZATION_ID=

# Supabase (Phase 1) — copiar a apps/web/.env.local y a Vercel (Production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Usa la anon key (JWT) o la publishable key (sb_publishable_...) del mismo proyecto
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Opcional alias (misma clave que ANON_KEY si usas publishable)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor — nunca en el cliente
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# Resend (Super Admin — emails de bienvenida)
# El remitente DEBE usar un dominio verificado en resend.com/domains (NO @*.vercel.app).
# Pruebas: onboarding@resend.dev (solo a tu email en cuenta de prueba)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# IA (Phase 1.1 — etiquetado, Fathom, formularios)
ANTHROPIC_API_KEY=
# Embeddings RAG (text-embedding-3-small)
OPENAI_API_KEY=
# Opcional: proteger cron de procesamiento Fathom
CRON_SECRET=

# Google OAuth (YouTube + Google Forms — misma app en Google Cloud)
# Habilitar APIs: YouTube Data, YouTube Analytics, Google Forms, Google Drive
# Si la app está en modo "Prueba": agregar cada email en OAuth consent screen → Test users
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/oauth/callback
GOOGLE_FORMS_REDIRECT_URI=http://localhost:3000/api/integrations/google-forms/oauth/callback

# Typeform
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
TYPEFORM_REDIRECT_URI=http://localhost:3000/api/integrations/typeform/oauth/callback

# Fathom (API key por organización en DB; opcional webhook global)
FATHOM_WEBHOOK_SECRET=
# Opcional — base de la API pública de Fathom
# FATHOM_API_BASE=https://api.fathom.ai/external/v1

# Calendly (Integración — Oleada E)
# Copiar a apps/web/.env.local
# - Crear OAuth app en Calendly Developer
# - Agregar redirect URI exactamente igual a CALENDLY_REDIRECT_URI
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
# Opcional (si no se define, se usa NEXT_PUBLIC_APP_URL + "/api/integrations/calendly/webhook")
CALENDLY_WEBHOOK_URL=

# Stripe Connect (Finanzas — balance y transacciones)
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_REDIRECT_URI=http://localhost:3000/api/integrations/stripe/callback

# Instagram / Meta (Instagram Login + Graph API — Marketing)
# Meta App Dashboard → Instagram → API setup with Instagram login
# Redirect URI debe coincidir exactamente con INSTAGRAM_REDIRECT_URI (sin trailing slash)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=otc_instagram_webhook_2024

# Discord (bot + OAuth integración)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/integrations/discord/callback
NEXT_PUBLIC_DISCORD_CLIENT_ID=
OTC_WEBHOOK_SECRET=

# Opcional
CALENDLY_AUTH_BASE=https://auth.calendly.com
CALENDLY_AUTH_TOKEN=https://auth.calendly.com/oauth/token
CALENDLY_SCOPES=organizations:read users:read scheduled_events:read webhooks:write
